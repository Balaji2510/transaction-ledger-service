              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Fetches all transactions for account, sorted newest first based on created_at."
          },
          "response": []
        },
        {
          "name": "5.2 Filter by Type: credit (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions?type=credit",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "type", "value": "credit" }
              ]
            },
            "description": "Returns only credit transactions."
          },
          "response": []
        },
        {
          "name": "5.3 Filter by Type: debit (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions?type=debit",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "type", "value": "debit" }
              ]
            },
            "description": "Returns only debit transactions."
          },
          "response": []
        },
        {
          "name": "5.4 Paginate History - Page 1 (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions?page=1&pageSize=2",
