    {
      "name": "4. Transactions & Data Integrity",
      "item": [
        {
          "name": "4.1 Credit Transaction (+100) (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"referenceId\": \"ref_credit_001\",\n  \"description\": \"Initial account funding\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Atomically credits account with 100 and updates account balance."
          },
          "response": []
        },
        {
          "name": "4.2 Credit Transaction (+50) (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"referenceId\": \"ref_credit_002\",\n  \"description\": \"Secondary deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Atomically credits another 50 (balance becomes 150)."
          },
          "response": []
        },
        {
          "name": "4.3 Debit Transaction (-30) (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 30,\n  \"referenceId\": \"ref_debit_001\",\n  \"description\": \"Utility bill\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Atomically debits 30 (balance becomes 120)."
          },
          "response": []
        },
        {
          "name": "4.4 Verify Resulting Balance (Should be 120) (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "balance"]
            },
            "description": "Verifies balance consistency (100 + 50 - 30 = 120)."
          },
          "response": []
        },
        {
          "name": "4.5 Overdraft Prevention - Insufficient Balance (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 500,\n  \"referenceId\": \"ref_overdraft_fail\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 400 Bad Request (INSUFFICIENT_BALANCE) without altering account balance."
          },
          "response": []
        },
        {
          "name": "4.6 Idempotency - Duplicate Reference ID (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"referenceId\": \"ref_credit_001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 409 Conflict when referenceId has already been used for this account."
          },
          "response": []
        },
        {
          "name": "4.7 Validation - Invalid Transaction Type (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"crypto\",\n  \"amount\": 50,\n  \"referenceId\": \"ref_invalid_type\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 400 Bad Request because transaction type must be credit or debit."
          },
          "response": []
        },
        {
          "name": "4.8 Validation - Negative/Zero Amount (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": -10,\n  \"referenceId\": \"ref_negative\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 400 Bad Request because amount must be > 0."
          },
          "response": []
        },
        {
          "name": "4.9 Validation - Missing Reference ID (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 400 Bad Request because referenceId is required for audit and idempotency."
          },
          "response": []
        },
        {
          "name": "4.10 Immutability - Attempt PUT (405)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 405 Method Not Allowed because transactions are immutable."
          },
          "response": []
        },
        {
          "name": "4.11 Immutability - Attempt DELETE (405)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"]
            },
            "description": "Expects 405 Method Not Allowed because transaction deletion is prohibited."
          },
          "response": []
        }
      ]
    },
    {
