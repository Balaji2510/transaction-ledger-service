              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "2" }
              ]
            },
            "description": "Returns page 1 with 2 records and complete pagination metadata."
          },
          "response": []
        },
        {
          "name": "5.5 Paginate History - Page 2 (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/transactions?page=2&pageSize=2",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "pageSize", "value": "2" }
              ]
            },
            "description": "Returns page 2 of transaction history."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Money Transfer (Bonus Feature)",
      "item": [
        {
          "name": "6.1 Successful Atomic Transfer (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{recipientAccountId}}\",\n  \"amount\": 40,\n  \"referenceId\": \"transfer_ref_001\",\n  \"description\": \"Consulting fee payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "transfer"]
            },
            "description": "Atomically transfers 40 from account 101 (120 -> 80) to account 102 (0 -> 40)."
          },
          "response": []
        },
        {
          "name": "6.2 Verify Source Account Balance (Should be 80) (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{accountId}}", "balance"]
            },
            "description": "Verifies source account balance after transfer (80)."
          },
          "response": []
        },
        {
          "name": "6.3 Verify Destination Account Balance (Should be 40) (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/{{recipientAccountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "{{recipientAccountId}}", "balance"]
            },
            "description": "Verifies destination account balance after transfer (40)."
          },
          "response": []
        },
        {
          "name": "6.4 Transfer - Insufficient Balance with Rollback (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{recipientAccountId}}\",\n  \"amount\": 500,\n  \"referenceId\": \"transfer_fail_insufficient\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "transfer"]
            },
            "description": "Expects 400 Bad Request; neither account balance is altered."
          },
          "response": []
        },
        {
          "name": "6.5 Transfer - Self Transfer Rejection (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{accountId}}\",\n  \"amount\": 20,\n  \"referenceId\": \"transfer_self_reject\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "transfer"]
            },
            "description": "Expects 400 Bad Request because fromAccountId and toAccountId cannot be the same."
          },
          "response": []
        },
        {
          "name": "6.6 Transfer - Destination Not Found (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"ghost_account_404\",\n  \"amount\": 20,\n  \"referenceId\": \"transfer_dest_404\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/accounts/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "accounts", "transfer"]
            },
            "description": "Expects 404 Not Found when destination account does not exist."
          },
          "response": []
        }
      ]
    }
  ]
